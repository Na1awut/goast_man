# Supabase project (Project Settings → API). Leave empty to run on demo data.
# Only the anon/public key belongs here. Never put the service_role key in the frontend.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Endpoint of the real PromptPay payment API. Leave empty until one exists:
# in live mode PromptPay stays hidden (cash only) while this is empty, because
# the QR screen is still a mock. Set it and PromptPay appears again.
PUBLIC_PROMPTPAY_API_URL=
