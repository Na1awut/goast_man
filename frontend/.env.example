# Supabase project (Project Settings → API). Leave empty to run on demo data.
# Only the anon/public key belongs here. Never put the service_role key in the frontend.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# PromptPay (paid to the team, slip checked with SlipOK). On the live site
# PromptPay stays hidden (cash only) until both of these are set.
# verify-slip Edge Function: https://<project-ref>.supabase.co/functions/v1/verify-slip
PUBLIC_PROMPTPAY_API_URL=
# The team's PromptPay number (mobile or 13-digit ID), the same account bound to the SlipOK branch
PUBLIC_PROMPTPAY_ID=
# Optional: account name shown under the QR, e.g. "Goose Man (นาย ก.)"
PUBLIC_PROMPTPAY_NAME=
# The SlipOK API key is a secret: it goes in Supabase Edge Function secrets, never here.
